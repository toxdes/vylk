{
  "name": "vylk-frontend-tests",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "build:css": "sass --no-source-map --style=expanded frontend/styles/app.scss static/style.css && prettier --write static/style.css",
    "check:css-build": "sass --no-source-map --style=expanded frontend/styles/app.scss /tmp/vylk-style.css && prettier --config .prettierrc.json --write /tmp/vylk-style.css && cmp static/style.css /tmp/vylk-style.css",
    "format": "prettier --write . && gofmt -w $(git ls-files '*.go') && bun run build:css",
    "format:check": "prettier --check .",
    "lint": "bun run lint:js && bun run lint:css && bun run lint:html",
    "lint:js": "eslint .",
    "lint:css": "stylelint 'frontend/**/*.scss'",
    "lint:html": "htmlhint 'static/**/*.html'",
    "test:frontend": "vitest run test && bun test ./static",
    "test:browser": "playwright test --config=playwright.config.js"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.62.1",
    "eslint": "10.5.0",
    "fake-indexeddb": "^6.2.4",
    "globals": "17.7.0",
    "htmlhint": "1.9.2",
    "jsdom": "^26.1.0",
    "prettier": "3.9.8",
    "sass": "^1.104.1",
    "stylelint": "17.15.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "vitest": "^3.2.4"
  }
}
